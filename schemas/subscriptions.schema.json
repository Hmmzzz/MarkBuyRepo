{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Hmmzzz/MarkBuyRepo/blob/main/schemas/subscriptions.schema.json",
  "title": "MarkBuy Popular Subscriptions Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "lastUpdated",
    "subscriptions"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "subscriptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subscription"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "nullableHttpUrl": {
      "anyOf": [
        {
          "$ref": "#/$defs/httpUrl"
        },
        {
          "type": "null"
        }
      ]
    },
    "appStoreId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "enum": [
        "video",
        "music",
        "productivity",
        "utility",
        "gaming",
        "news",
        "lifestyle",
        "entertainment",
        "other"
      ]
    },
    "billingCycle": {
      "enum": [
        "monthly",
        "quarterly",
        "semiAnnually",
        "annually",
        "custom"
      ]
    },
    "icon": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://raw\\.githubusercontent\\.com/Hmmzzz/MarkBuyRepo/main/subsicon/[a-z0-9][a-z0-9-]*\\.png$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pricingOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "price",
        "currency",
        "billingCycle",
        "isPermanent"
      ],
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "billingCycle": {
          "$ref": "#/$defs/billingCycle"
        },
        "isPermanent": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        }
      }
    },
    "bundledSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "icon",
        "category",
        "price",
        "currency",
        "billingCycle",
        "isPermanent",
        "tags"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "originalPrice": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "billingCycle": {
          "$ref": "#/$defs/billingCycle"
        },
        "isPermanent": {
          "type": "boolean"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "website": {
          "$ref": "#/$defs/nullableHttpUrl"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "appStoreId": {
          "$ref": "#/$defs/appStoreId"
        }
      }
    },
    "subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "icon",
        "category",
        "commonPrices",
        "tags",
        "region"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "$ref": "#/$defs/icon"
        },
        "category": {
          "$ref": "#/$defs/category"
        },
        "commonPrices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pricingOption"
          }
        },
        "website": {
          "$ref": "#/$defs/nullableHttpUrl"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        },
        "region": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:[A-Z]{2}|Global)$"
          }
        },
        "appStoreId": {
          "$ref": "#/$defs/appStoreId"
        },
        "isBundle": {
          "type": "boolean"
        },
        "bundledSubscriptions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundledSubscription"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "isBundle"
            ],
            "properties": {
              "isBundle": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "bundledSubscriptions"
            ]
          }
        },
        {
          "if": {
            "required": [
              "bundledSubscriptions"
            ]
          },
          "then": {
            "required": [
              "isBundle"
            ],
            "properties": {
              "isBundle": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
